# Server-only site configuration.
SITE_URL=https://getpcspa.com

# Allowed values: development, preview, production.
CLOUDFLARE_ENV=development

# Must match the D1 database_name in wrangler.toml.
D1_DATABASE_NAME=pcspa

# Secret used to sign short-lived desktop license session tokens.
# Set locally for development and with `wrangler secret put LICENSE_TOKEN_SECRET` in Cloudflare.
LICENSE_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
